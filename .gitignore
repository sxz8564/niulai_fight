node_modules/
dist/
# ...except the bundle. This folder is loaded unpacked straight from a clone,
# so the one build artifact the page actually needs is committed. Rebuild it
# with `npm run build` after changing anything under src/.
!dist/
dist/*
!dist/bundle.js
.DS_Store
*.log
.smoke/

# Meshy's one-clip-per-file exports, ~5 MB each and all carrying the same mesh.
# tools/merge-animations.mjs turns them into assets/models/niulai-rigged.glb,
# which is what the game loads and what is committed.
incoming/
